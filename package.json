{
  "name": "doubt-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation for the Doubt Discord bot (docs.doubtbot.eu)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "biome check .",
    "biome:ci": "biome ci .",
    "biome:fix": "biome check --write . && biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  }
}
